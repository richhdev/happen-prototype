{
  "name": "happen",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:lan": "next dev --turbopack -H 0.0.0.0 -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "storybook": "storybook dev -p 6006",
    "storybook-build": "storybook build -o public/storybook",
    "lighthouse": "pnpm lighthouse:mobile & pnpm lighthouse:desktop",
    "lighthouse:mobile": "lighthouse http://localhost:3000 --chrome-flags=\"--headless=new\" --output=html --output-path=public/lighthouse/mobile/index.html",
    "lighthouse:desktop": "lighthouse http://localhost:3000 --preset=desktop --chrome-flags=\"--headless=new\" --output=html --output-path=public/lighthouse/desktop/index.html",
    "compile-stylesheet-framer": "node scripts/compile-stylesheet-framer.mjs",
    "assets": "./scripts/build-assets.sh",
    "screenshot": "node scripts/screenshot.mjs",
    "devstart": "(sleep 2 && open -a 'Firefox Developer Edition' http://localhost:3000) & BROWSER='Firefox Developer Edition' storybook dev -p 6006 & next dev --turbopack"
  },
  "dependencies": {
    "next": "^15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "^15.1.6",
    "framer-motion": "^11.18.2",
    "lighthouse": "^13.4.1",
    "lightningcss": "^1.33.0",
    "playwright": "^1.62.1",
    "storybook": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "vite": "^7.0.6"
  }
}
